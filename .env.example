SECRET_KEY=your-super-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,traenergie.vercel.app
VERCEL_URL=traenergie.vercel.app

# Database (SQLite en local, URL PostgreSQL Supabase sur Vercel)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# DATABASE_URL=sqlite:///db.sqlite3
# Exemple Supabase : postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-app-password
DEFAULT_FROM_EMAIL=your-email@example.com
